---
import '../styles/collaboration.scss'
---

<section class="collaboration" id="collaboration">
	<div class="collaboration-header">
		<span class="collaboration-header-label">Services</span>
		<h1 class="collaboration-header-title">Our Collaboration</h1>
	</div>

	<div class="collaboration-content">
		<div class="collaboration-card reveal-card">
			<div class="collaboration-card-text">
				<h2>Web Development</h2>
				<p>
					Transform your business with dynamic, responsive websites tailored to your needs. Let's
					create a stunning digital presence that drives engagement and growth.
				</p>
				<div class="collaboration-card-stack">
					<div class="collaboration-card-stack-item" data-tooltip="Webflow">
						<img src="/images/apps/webflow.svg" alt="Webflow" />
					</div>
					<div class="collaboration-card-stack-item" data-tooltip="Framer">
						<img src="/images/apps/framer.svg" alt="Framer" />
					</div>
					<div class="collaboration-card-stack-item" data-tooltip="Squarespace">
						<img src="/images/apps/squarespace.svg" alt="Squarespace" />
					</div>
					<div class="collaboration-card-stack-item" data-tooltip="WordPress">
						<img src="/images/apps/wordpress.svg" alt="WordPress" />
					</div>
					<div class="collaboration-card-stack-item" data-tooltip="Custom Code">
						<img src="/images/apps/custom.svg" alt="Custom code" />
					</div>
				</div>
			</div>
			<div class="collaboration-card-visual">
				<img src="/images/mockups/code.jpg" alt="Web Development" />
			</div>
		</div>

		<div class="collaboration-card reveal-card">
			<div class="collaboration-card-text">
				<h2>UI/UX Design</h2>
				<p>
					Elevate your brand with user-centric designs that are both beautiful and functional. I craft
					layouts that ensure seamless user flow and memorable experiences.
				</p>
				<div class="collaboration-card-stack">
					<div class="collaboration-card-stack-item" data-tooltip="Figma">
						<img src="/images/apps/figma.svg" alt="Figma" />
					</div>
				</div>
			</div>
			<div class="collaboration-card-visual">
				<img src="/images/mockups/mockup.png" alt="UI/UX Design" />
			</div>
		</div>

		<div class="collaboration-card reveal-card">
			<div class="collaboration-card-text">
				<h2>Branding</h2>
				<p>
					Let's enhance your business brand with consistent style guides, hierarchy, and imagery that
					convey your essence and mission to users.
				</p>
				<div class="collaboration-card-stack">
					<div class="collaboration-card-stack-item" data-tooltip="Figma">
						<img src="/images/apps/figma.svg" alt="Figma" />
					</div>
					<div class="collaboration-card-stack-item" data-tooltip="Illustrator">
						<img src="/images/apps/ai.svg" alt="Illustrator" />
					</div>
					<div class="collaboration-card-stack-item" data-tooltip="Photoshop">
						<img src="/images/apps/ps.svg" alt="Photoshop" />
					</div>
				</div>
			</div>
			<div class="collaboration-card-visual">
				<img src="/images/mockups/design.jpg" alt="Branding" />
			</div>
		</div>
	</div>
</section>

<script>
	import gsap from 'gsap'
	import { ScrollTrigger } from 'gsap/ScrollTrigger'
	gsap.registerPlugin(ScrollTrigger)

	// Header reveal
	const collabHeader = document.querySelector('.collaboration-header')
	gsap.from(collabHeader, {
		opacity: 0,
		y: 40,
		ease: 'power3.out',
		scrollTrigger: {
			trigger: collabHeader,
			start: 'top 85%',
			end: 'top 55%',
			scrub: 1
		}
	})

	// Card reveals - each card reveals as you scroll to it
	const cards = document.querySelectorAll('.reveal-card')
	cards.forEach((card) => {
		gsap.from(card, {
			opacity: 0,
			y: 60,
			scale: 0.97,
			ease: 'power3.out',
			scrollTrigger: {
				trigger: card,
				start: 'top 85%',
				end: 'top 50%',
				scrub: 1
			}
		})

		// Parallax on the visual inside each card
		const visual = card.querySelector('.collaboration-card-visual')
		if (visual) {
			gsap.from(visual, {
				xPercent: 20,
				opacity: 0,
				ease: 'power3.out',
				scrollTrigger: {
					trigger: card,
					start: 'top 75%',
					end: 'top 35%',
					scrub: 1
				}
			})
		}
	})
</script>
